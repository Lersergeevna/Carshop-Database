<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="000-create-global-sequence" author="lera">
        <preConditions onFail="MARK_RAN">
            <not>
                <sequenceExists sequenceName="global_sequence"/>
            </not>
        </preConditions>
        <createSequence sequenceName="global_sequence" startValue="1" incrementBy="1"/>
    </changeSet>

    <changeSet id="001-create-client-number-sequence" author="lera">
        <preConditions onFail="MARK_RAN">
            <not>
                <sequenceExists sequenceName="client_number_sequence"/>
            </not>
        </preConditions>
        <createSequence sequenceName="client_number_sequence" startValue="1" incrementBy="1"/>
    </changeSet>

    <changeSet id="002-create-sale-number-sequence" author="lera">
        <preConditions onFail="MARK_RAN">
            <not>
                <sequenceExists sequenceName="sale_number_sequence"/>
            </not>
        </preConditions>
        <createSequence sequenceName="sale_number_sequence" startValue="1" incrementBy="1"/>
    </changeSet>

    <changeSet id="003-create-car-inventory-sequence" author="lera">
        <preConditions onFail="MARK_RAN">
            <not>
                <sequenceExists sequenceName="car_inventory_sequence"/>
            </not>
        </preConditions>
        <createSequence sequenceName="car_inventory_sequence" startValue="1" incrementBy="1"/>
    </changeSet>

    <changeSet id="004-create-employee-number-sequence" author="lera">
        <preConditions onFail="MARK_RAN">
            <not>
                <sequenceExists sequenceName="employee_number_sequence"/>
            </not>
        </preConditions>
        <createSequence sequenceName="employee_number_sequence" startValue="1" incrementBy="1"/>
    </changeSet>

    <changeSet id="005-create-persons-table" author="lera">
    <preConditions onFail="MARK_RAN">
        <not>
            <tableExists tableName="persons"/>
        </not>
    </preConditions>

    <createTable tableName="persons">
        <column name="id" type="BIGINT">
            <constraints primaryKey="true" nullable="false"/>
        </column>

        <column name="full_name" type="VARCHAR(100)">
            <constraints nullable="false"/>
        </column>

        <column name="email" type="VARCHAR(100)">
            <constraints nullable="false" unique="true"/>
        </column>

        <column name="phone" type="VARCHAR(20)">
            <constraints nullable="false" unique="true"/>
        </column>
    </createTable>
    </changeSet>

    <changeSet id="006-create-clients-table" author="lera">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="clients"/>
            </not>
        </preConditions>

        <createTable tableName="clients">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="client_number" type="VARCHAR(20)">
                <constraints nullable="false" unique="true"/>
            </column>

            <column name="discount_percentage" type="NUMERIC(5,2)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="clients"
                baseColumnNames="id"
                referencedTableName="persons"
                referencedColumnNames="id"
                constraintName="fk_clients_persons"/>
    </changeSet>

    <changeSet id="007-create-managers-table" author="lera">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="managers"/>
            </not>
        </preConditions>

        <createTable tableName="managers">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="employee_number" type="VARCHAR(20)">
                <constraints nullable="false" unique="true"/>
            </column>

            <column name="position" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="managers"
                baseColumnNames="id"
                referencedTableName="persons"
                referencedColumnNames="id"
                constraintName="fk_managers_persons"/>
    </changeSet>

    <changeSet id="008-create-cars-table" author="lera">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="cars"/>
            </not>
        </preConditions>

        <createTable tableName="cars">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="inventory_number" type="VARCHAR(20)">
                <constraints nullable="false" unique="true"/>
            </column>

            <column name="brand" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>

            <column name="model" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>

            <column name="manufacture_year" type="INTEGER">
                <constraints nullable="false"/>
            </column>

            <column name="horse_power" type="INTEGER">
                <constraints nullable="false"/>
            </column>

            <column name="price" type="NUMERIC(12,2)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="009-create-car-passports-table" author="lera">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="car_passports"/>
            </not>
        </preConditions>

        <createTable tableName="car_passports">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="vin" type="VARCHAR(17)">
                <constraints nullable="false" unique="true"/>
            </column>

            <column name="color" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>

            <column name="engine_number" type="VARCHAR(50)">
                <constraints nullable="false" unique="true"/>
            </column>

            <column name="car_id" type="BIGINT">
                <constraints nullable="false" unique="true"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="car_passports"
                baseColumnNames="car_id"
                referencedTableName="cars"
                referencedColumnNames="id"
                constraintName="fk_car_passports_cars"/>
    </changeSet>

    <changeSet id="010-create-sales-table" author="lera">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="sales"/>
            </not>
        </preConditions>

        <createTable tableName="sales">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="sale_number" type="VARCHAR(20)">
                <constraints nullable="false" unique="true"/>
            </column>

            <column name="sale_date" type="DATE">
                <constraints nullable="false"/>
            </column>

            <column name="final_price" type="NUMERIC(12,2)">
                <constraints nullable="false"/>
            </column>

            <column name="client_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="manager_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="car_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="sales"
                baseColumnNames="client_id"
                referencedTableName="clients"
                referencedColumnNames="id"
                constraintName="fk_sales_clients"/>

        <addForeignKeyConstraint
                baseTableName="sales"
                baseColumnNames="manager_id"
                referencedTableName="managers"
                referencedColumnNames="id"
                constraintName="fk_sales_managers"/>

        <addForeignKeyConstraint
                baseTableName="sales"
                baseColumnNames="car_id"
                referencedTableName="cars"
                referencedColumnNames="id"
                constraintName="fk_sales_cars"/>
    </changeSet>

    <changeSet id="011-create-client-favorite-cars-table" author="lera">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="client_favorite_cars"/>
            </not>
        </preConditions>

        <createTable tableName="client_favorite_cars">
            <column name="client_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="car_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey
                tableName="client_favorite_cars"
                columnNames="client_id, car_id"
                constraintName="pk_client_favorite_cars"/>

        <addForeignKeyConstraint
                baseTableName="client_favorite_cars"
                baseColumnNames="client_id"
                referencedTableName="clients"
                referencedColumnNames="id"
                constraintName="fk_client_favorite_cars_clients"/>

        <addForeignKeyConstraint
                baseTableName="client_favorite_cars"
                baseColumnNames="car_id"
                referencedTableName="cars"
                referencedColumnNames="id"
                constraintName="fk_client_favorite_cars_cars"/>
    </changeSet>

    <changeSet id="012-drop-car-passports-cars-foreign-key" author="lera">
        <preConditions onFail="MARK_RAN">
            <foreignKeyConstraintExists foreignKeyName="fkqgfyf0cjrmqr8bmvuu1i66sek"/>
        </preConditions>

        <dropForeignKeyConstraint
                baseTableName="car_passports"
                constraintName="fkqgfyf0cjrmqr8bmvuu1i66sek"/>
    </changeSet>
</databaseChangeLog>